# .env.example

# --- КРИТИЧЕСКИ ВАЖНО ---
# Скопируйте этот файл в .env на вашем компьютере для тестов,
# но НИКОГДА не добавляйте .env в git (он должен быть в .gitignore).

# Основные настройки N8N
N8N_ENCRYPTION_KEY=<ЗДЕСЬ_НУЖЕН_ОЧЕНЬ_СЛОЖНЫЙ_КЛЮЧ_ИЗ_32_СИМВОЛОВ>
N8N_HOST=${AMVERA_DOMAIN} # Amvera сама подставит ваш бесплатный домен
N8N_PORT=5678
N8N_PROTOCOL=https

# Настройки Базы Данных (Amvera предоставляет Postgres URL)
DB_TYPE=postgresdb
DB_POSTGRESDB_DATABASE=${POSTGRES_DB}
DB_POSTGRESDB_HOST=${POSTGRES_HOST}
DB_POSTGRESDB_PORT=${POSTGRES_PORT}
DB_POSTGRESDB_USER=${POSTGRES_USER}
DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD}

# Включаем установку сторонних нод (Community Nodes), чтобы поставить Amvera LLM
N8N_COMMUNITY_NODES_ENABLED=true

# Токены доступа самого n8n (для API вызовов между воркерами)
N8N_API_KEY=<ВАШ_БЕЗОПАСНЫЙ_ТОКЕН>
